<?xml version="1.0"?>
<robot name="magang">

    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.4 0.4 0.1"/>
            </geometry>
            <material name='grey'>
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
    </link>

    <link name="femur">
        <visual>
            <origin xyz="0 0 0.2"/>
            <geometry>
                <cylinder radius="0.05" length="0.4"/>
            </geometry>
            <material name='grey'>
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
    </link>

    <link name="tibia">
        <visual>
            <origin xyz="0 0 0.15"/>
            <geometry>
                <cylinder radius="0.03" length="0.4"/>
            </geometry>
            <material name='grey'>
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
    </link>

    <link name="gripper">
        <visual>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <cylinder radius="0.02" length="0.1"/>
            </geometry>
            <material name='grey'>
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
    </link>

    <link name="gripper_hand1">
        <visual>
            <origin xyz="0 -0.04 0"/>
            <geometry>
                <box size="0.03 0.03 0.1"/>            
            </geometry>
            <material name='grey'>
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
    </link>


    <link name="gripper_hand2">
        <visual>
            <origin xyz="0 0.04 0"/>
            <geometry>
                <box size="0.03 0.03 0.1"/>            
            </geometry>
            <material name='grey'>
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
    </link>


    <joint name="joint_1" type="revolute">
        <parent link="base_link"/>
        <child link="femur"/>
        <origin xyz="0 0 0.05"/> 
        <axis xyz="0 0 1"/>
        <limit effort="10" velocity="1.0" lower="-3.14" upper="3.14" />    <!-- limit satuan rad-->
    </joint>

    <joint name="joint_2" type="revolute">
        <parent link="femur"/>
        <child link="tibia"/>
        <origin xyz="0 0 0.4"/>
        <axis xyz="0 1 0"/>
        <limit effort="10" velocity="1.0" lower="-1" upper="1" />    
    </joint>

    <joint name="joint_3" type="revolute">
        <parent link="tibia"/>
        <child link="gripper"/>
        <origin xyz="0 0 0.3"/>
        <axis xyz="0 1 0"/>
        <limit effort="10" velocity="1.0" lower="-1" upper="1" />    
    </joint>

    <joint name="joint_4" type="fixed">
        <parent link="gripper"/>
        <child link="gripper_hand1"/>
        <origin xyz="0 0 0.2" rpy="0.9 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="joint_5" type="fixed">
        <parent link="gripper"/>
        <child link="gripper_hand2"/>
        <origin xyz="0 0 0.2" rpy="-0.9 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <ros2_control name="arm_ros2_control" type="system">
        <hardware>
            <plugin> mock_components/GenericSystem </plugin>
        </hardware>

        <joint name= "joint_1">
            <command_interface name="position"/>
            <state_interface name= "position"/>
        </joint>

        <joint name= "joint_2">
            <command_interface name="position"/>
            <state_interface name= "position"/>
        </joint>

        <joint name= "joint_3">
            <command_interface name="position"/>
            <state_interface name= "position"/>
        </joint>

    </ros2_control> 

</robot>