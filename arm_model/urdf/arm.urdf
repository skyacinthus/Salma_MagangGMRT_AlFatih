<?xml version="1.0"?>
<robot name="magang">

    <link name="base_link">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.1"/>
            </geometry>
            <material>
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
    </link>

    <link name="femur">
        <visual>
            <origin xyz="0 0 0.2"/>
            <geometry>
                <cylinder radius="0.05" length="0.4"/>
            </geometry>
            <material>
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
    </link>

    <link name="tibia">
        <visual>
            <origin xyz="0 0 0.15"/>
            <geometry>
                <cylinder radius="0.03" length="0.4"/>
            </geometry>
            <material>
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
    </link>

    <link name="gripper">
        <visual>
            <origin xyz="0 0 0.08"/>
            <geometry>
                <cylinder radius="0.02" length="0.2"/>
            </geometry>
            <material>
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
    </link>

    <link name="gripper_hand">
        <visual>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <box size="0.07 0.07 0.07"/>            
            </geometry>
            <material>
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
    </link>


    <joint name="joint_1" type="continuous">
        <parent link="base_link"/>
        <child link="femur"/>
        <origin xyz="0 0 0.05"/> 
        <axis xyz="0 0 1"/>
    </joint>

    <joint name="joint_2" type="revolute">
        <parent link="femur"/>
        <child link="tibia"/>
        <origin xyz="0 0 0.4"/>
        <axis xyz="0 1 0"/>
        <limit effort="10" velocity="1.0" lower="-1" upper="1" />    <!-- limit satuan rad-->
    </joint>

    <joint name="joint_3" type="revolute">
        <parent link="tibia"/>
        <child link="gripper"/>
        <origin xyz="0 0 0.35"/>
        <axis xyz="0 1 0"/>
        <limit effort="10" velocity="1.0" lower="-1" upper="1" />    
    </joint>

    <joint name="joint_4" type="fixed">
        <parent link="gripper"/>
        <child link="gripper_hand"/>
        <origin xyz="0 0 0.1"/>
        <axis xyz="0 1 0"/>
    </joint>

</robot>